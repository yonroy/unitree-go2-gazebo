<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="flat_ground">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Vat can tinh cho ne vat can + SLAM (quadruped_navigation/lidar).
         Cot + tuong bo tri quanh diem spawn de robot LiDAR quet + ne + dung ban do. -->
    <model name="obstacles">
      <static>true</static>
      <link name="link">
        <!-- 3 cot vuong -->
        <collision name="c1"><pose>2.0 1.2 0.4 0 0 0</pose><geometry><box><size>0.4 0.4 0.8</size></box></geometry></collision>
        <visual name="c1v"><pose>2.0 1.2 0.4 0 0 0</pose><geometry><box><size>0.4 0.4 0.8</size></box></geometry><material><ambient>0.7 0.3 0.3 1</ambient><diffuse>0.8 0.35 0.35 1</diffuse></material></visual>
        <collision name="c2"><pose>2.5 -1.5 0.4 0 0 0</pose><geometry><box><size>0.4 0.4 0.8</size></box></geometry></collision>
        <visual name="c2v"><pose>2.5 -1.5 0.4 0 0 0</pose><geometry><box><size>0.4 0.4 0.8</size></box></geometry><material><ambient>0.7 0.3 0.3 1</ambient><diffuse>0.8 0.35 0.35 1</diffuse></material></visual>
        <collision name="c3"><pose>4.0 0.5 0.4 0 0 0</pose><geometry><box><size>0.4 0.4 0.8</size></box></geometry></collision>
        <visual name="c3v"><pose>4.0 0.5 0.4 0 0 0</pose><geometry><box><size>0.4 0.4 0.8</size></box></geometry><material><ambient>0.7 0.3 0.3 1</ambient><diffuse>0.8 0.35 0.35 1</diffuse></material></visual>
        <!-- 1 buc tuong -->
        <collision name="w1"><pose>5.0 -1.0 0.4 0 0 0</pose><geometry><box><size>0.2 3.0 0.8</size></box></geometry></collision>
        <visual name="w1v"><pose>5.0 -1.0 0.4 0 0 0</pose><geometry><box><size>0.2 3.0 0.8</size></box></geometry><material><ambient>0.4 0.45 0.6 1</ambient><diffuse>0.5 0.55 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Vat the test cho track_object (quadruped_follow) - qua cau mau cam,
         dat truoc diem spawn robot. VelocityControl cho phep dieu khien
         van toc tu ROS qua topic /model/target_ball/cmd_vel (bridge trong
         quadruped_description/launch/gazebo.launch.py) de mo phong muc
         tieu di chuyen khi test bam duoi. -->
    <model name="target_ball">
      <pose>1.5 0 0.12 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <sphere><radius>0.12</radius></sphere>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere><radius>0.12</radius></sphere>
          </geometry>
          <material>
            <ambient>0.9 0.4 0.05 1</ambient>
            <diffuse>0.95 0.45 0.05 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <link_name>link</link_name>
      </plugin>
    </model>

    <gravity>0 0 -9.81</gravity>
  </world>
</sdf>
