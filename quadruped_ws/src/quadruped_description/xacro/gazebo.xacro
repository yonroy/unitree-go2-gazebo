<?xml version="1.0"?>
<!--
Plugin gz_ros2_control cho Gazebo Harmonic (thay the libgazebo_ros_control.so cua
ban ROS1 goc). File config controller (joint_state_broadcaster + forward_position_controller)
nam o config/go2_controllers.yaml.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find quadruped_description)/config/go2_controllers.yaml</parameters>
        </plugin>
    </gazebo>

    <!-- Odometry ground-truth (chua co SLAM/localization that) - dung cho
         quadruped_navigation/goto_point_server. Goc odom = diem robot spawn. -->
    <gazebo>
        <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
            <odom_frame>odom</odom_frame>
            <robot_base_frame>trunk</robot_base_frame>
            <odom_topic>odom</odom_topic>
            <odom_publish_frequency>30</odom_publish_frequency>
            <dimensions>3</dimensions>
        </plugin>
    </gazebo>

    <gazebo reference="imu_link">
        <sensor name="imu_sensor" type="imu">
            <always_on>true</always_on>
            <update_rate>200</update_rate>
            <topic>imu/data</topic>
        </sensor>
    </gazebo>

    <!-- Camera RGBD dung cho track_object (quadruped_perception) - publish
         camera/image (mau), camera/depth_image (32FC1), camera/camera_info.
         gz-sim-sensors-system + render_engine ogre2 da bat san trong
         worlds/flat_ground.sdf. -->
    <gazebo reference="camera_link">
        <sensor name="camera_sensor" type="rgbd_camera">
            <always_on>true</always_on>
            <update_rate>15</update_rate>
            <topic>camera</topic>
            <camera>
                <horizontal_fov>1.05</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>20.0</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>

    <xacro:macro name="foot_friction" params="name">
        <gazebo reference="${name}_foot">
            <mu1>0.6</mu1>
            <mu2>0.6</mu2>
        </gazebo>
    </xacro:macro>
    <xacro:foot_friction name="FR"/>
    <xacro:foot_friction name="FL"/>
    <xacro:foot_friction name="RR"/>
    <xacro:foot_friction name="RL"/>

</robot>
