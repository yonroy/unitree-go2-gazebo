<mujoco model="go2 obstacle field">
  <include file="go2.xml"/>

  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-30"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="obstacle" rgba="0.75 0.35 0.35 1"/>
    <material name="wall" rgba="0.45 0.5 0.65 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Nhieu vat can (group 3 -> raycast LiDAR chi bat group nay, khong trung robot).
         Rai kin san ~7x7m, chua trong o giua (0,0) cho robot spawn, chua khe di lai. -->
    <geom name="o1"  type="cylinder" group="3" material="obstacle" size="0.28 0.5" pos="1.5 0.6 0.5"/>
    <geom name="o2"  type="cylinder" group="3" material="obstacle" size="0.25 0.5" pos="2.6 -0.7 0.5"/>
    <geom name="o3"  type="cylinder" group="3" material="obstacle" size="0.30 0.5" pos="1.3 -2.1 0.5"/>
    <geom name="o4"  type="cylinder" group="3" material="obstacle" size="0.25 0.5" pos="2.7 1.9 0.5"/>
    <geom name="o5"  type="cylinder" group="3" material="obstacle" size="0.28 0.5" pos="0.2 2.3 0.5"/>
    <geom name="o6"  type="cylinder" group="3" material="obstacle" size="0.25 0.5" pos="-1.4 1.3 0.5"/>
    <geom name="o7"  type="cylinder" group="3" material="obstacle" size="0.30 0.5" pos="-2.5 0.5 0.5"/>
    <geom name="o8"  type="cylinder" group="3" material="obstacle" size="0.25 0.5" pos="-1.7 -1.4 0.5"/>
    <geom name="o9"  type="cylinder" group="3" material="obstacle" size="0.28 0.5" pos="-2.6 -2.2 0.5"/>
    <geom name="o10" type="cylinder" group="3" material="obstacle" size="0.25 0.5" pos="0.9 1.4 0.5"/>
    <geom name="b1"  type="box"      group="3" material="obstacle" size="0.35 0.35 0.5" pos="-0.4 -2.4 0.5"/>
    <geom name="b2"  type="box"      group="3" material="obstacle" size="0.3 0.3 0.5"   pos="2.2 2.6 0.5"/>
    <geom name="b3"  type="box"      group="3" material="obstacle" size="0.4 0.25 0.5"  pos="-2.9 1.8 0.5"/>

    <!-- Tuong bao (~7x7m) de robot khong di ra vo tan -->
    <geom name="wN" type="box" group="3" material="wall" size="3.6 0.1 0.5" pos="0 3.6 0.5"/>
    <geom name="wS" type="box" group="3" material="wall" size="3.6 0.1 0.5" pos="0 -3.6 0.5"/>
    <geom name="wE" type="box" group="3" material="wall" size="0.1 3.6 0.5" pos="3.6 0 0.5"/>
    <geom name="wW" type="box" group="3" material="wall" size="0.1 3.6 0.5" pos="-3.6 0 0.5"/>
  </worldbody>
</mujoco>
