<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>quadruped_rl</name>
  <version>0.1.0</version>
  <description>RL locomotion cho Go2: chay policy ONNX (diasAiMaster/unitree-go2-velocity-flat, BSD-3) thay gait rule-based. Node dung obs 45 chieu tu IMU/joint_states/cmd_vel -> ONNX -> PD torque -> joint_effort_controller.</description>
  <maintainer email="tranminhtoan14062001@gmail.com">minhtoan</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>controller_manager_msgs</depend>
  <exec_depend>quadruped_description</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <!-- onnxruntime + numpy cai qua pip (khong phai rosdep) - xem CLAUDE.md -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
